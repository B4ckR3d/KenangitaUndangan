@keyframes left-right {=20
  0% { transform: translateX(8%); }
  100% { transform: translateX(0%); }
}

.left-right img { animation: 3s ease-in-out 0s infinite alternate none runn=
ing left-right; }

@keyframes wave-right {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(10deg); }
}

.wave-right img { animation: 4s ease-in-out 0s infinite alternate none runn=
ing wave-right; }

@keyframes wave-left {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-10deg); }
}

.wave-left img { animation: 4s ease-in-out 0s infinite alternate none runni=
ng wave-left; }

